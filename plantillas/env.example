# Copia este archivo como .env, en la misma carpeta que el docker-compose, y
# rellenalo. NUNCA lo subas a GitHub ni lo pegues en un chat: aqui van tus
# claves. Guarda una copia en tu gestor de contrasenas.
#
# Para las claves aleatorias, en una terminal:
#   openssl rand -hex 32     (64 caracteres: la que pide ENCRYPTION_KEY)
#   openssl rand -hex 24     (48 caracteres: para todas las demas)
# Solo letras y numeros: un $, un espacio o una comilla rompen la conexion.

# --- Tu panel -----------------------------------------------------------------

# La direccion donde vivira el panel, sin https:// (ej. openreply.tudominio.com).
# En un VPS de Hostinger sirve sin tocar DNS: algo.srvXXXXXXX.hstgr.cloud
DOMINIO=

# La imagen que construyo tu GitHub (Actions -> Packages).
# Ej. ghcr.io/tu-usuario/openreply:sha-1234567
OPENREPLY_IMAGE=

# Los correos que pueden entrar al panel, separados por comas y sin espacios.
ALLOWED_EMAILS=tu@correo.com

# --- Claves internas (aleatorias, ver arriba) ---------------------------------

NEXTAUTH_SECRET=
CRON_SECRET=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
# La inventas tu y luego la pegas tal cual en Meta, al conectar el webhook.
WEBHOOK_VERIFY_TOKEN=

# --- Correo de los enlaces de acceso (elige UNA opcion) -----------------------

# Opcion A, tu propio buzon. La @ del usuario se escribe %40.
# Mejor un buzon dedicado que tu correo personal: una "contrasena de
# aplicacion" de Gmail se salta tu verificacion en dos pasos.
# EMAIL_SERVER=smtps://usuario%40tudominio.com:CLAVE@smtp.tuproveedor.com:465
EMAIL_SERVER=

# Opcion B, Resend (resend.com).
RESEND_API_KEY=

# Quien firma los correos. Tiene que ser una direccion de ese buzon o dominio.
EMAIL_FROM=OpenReply <panel@tudominio.com>

# --- Meta (se rellena en la primera mitad de la guia de Meta) ------------------

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_SECRET=
META_GRAPH_API_VERSION=v25.0

# --- Solo si usas docker-compose.traefik.yml ----------------------------------
# Valores de la plantilla de n8n de Hostinger. Cambialos si tu Traefik es otro.
# TRAEFIK_RED=n8n_default
# TRAEFIK_ENTRADA=websecure
# TRAEFIK_CERTIFICADOS=mytlschallenge
